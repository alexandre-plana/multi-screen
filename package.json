{
  "name": "multi-screen",
  "version": "0.1.0",
  "description": "Compose screens from dockview panels, route them dynamically at runtime and push them to any device: send, update, theme and tune the display remotely.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./dockview": {
      "types": "./dist/dockview/index.d.ts",
      "import": "./dist/dockview/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "multi-screen-relay": "./dist/server/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite --config examples/vite.config.ts",
    "build:examples": "vite build --config examples/vite.config.ts",
    "relay": "node dist/server/cli.js",
    "check:package": "node scripts/check-package.mjs",
    "test:e2e": "node e2e/run.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:package && npm run build:examples",
    "prepack": "npm run build"
  },
  "dependencies": {
    "history": "^5.3.0",
    "path-to-regexp": "^8.4.2"
  },
  "peerDependencies": {
    "dockview": ">=4.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "dockview": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "dockview": "8.8.3",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.22.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dockview",
    "multi-screen",
    "digital-signage",
    "video-wall",
    "dashboard",
    "layout",
    "router",
    "remote-control",
    "websocket",
    "broadcastchannel",
    "typescript"
  ],
  "license": "MIT",
  "author": "Alexandre Plana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandre-plana/multi-screen.git"
  },
  "bugs": "https://github.com/alexandre-plana/multi-screen/issues",
  "homepage": "https://alexandre-plana.github.io/multi-screen/",
  "publishConfig": {
    "access": "public"
  }
}
